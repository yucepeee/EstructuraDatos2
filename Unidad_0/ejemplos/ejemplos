def obtener_maximo(numeros):
    """Encuentra el valor máximo dentro de una lista de números.

    Args:
        numeros (list): Lista con elementos numéricos.

    Returns:
        int o float: El número con el valor más alto.
    """
    if not numeros:
        return None

    maximo = numeros[0]
    for numero in numeros:
        if numero > maximo:
            maximo = numero
    return maximo


if __name__ == "__main__":
    # Llamada al metodo obtener_maximo()
    calificaciones = [85, 92, 78, 95, 88]
    nota_alta = obtener_maximo(calificaciones)
    print(f"La calificación más alta es: {nota_alta}")

