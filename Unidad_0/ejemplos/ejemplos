def apilar(pila, elemento):
    """Agrega un elemento en la cima de la pila."""
    pila.append(elemento)


def desapilar(pila):
    """Remueve y retorna el último elemento ingresado en la pila.

    Returns:
        Any: El elemento removido o None si la pila está vacía.
    """
    if not pila:
        return None
    return pila.pop()


if __name__ == "__main__":
    pila_navegacion = []

    # Insertar elementos
    apilar(pila_navegacion, 1)
    apilar(pila_navegacion, 3)
    apilar(pila_navegacion, 6)
    apilar(pila_navegacion, 2)
    apilar(pila_navegacion, 8)

    print(f"Estado de la pila: {pila_navegacion}")

    # Extraer el último elemento ingresado
    ultimo_sitio = desapilar(pila_navegacion)
    print(f"Elemento removido: {ultimo_sitio}")
    print(f"Pila actual: {pila_navegacion}")