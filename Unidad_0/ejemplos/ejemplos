import math

class Geometria:
    """Clase para cálculos geométricos básicos."""

    def __init__(self, radio):
        """Initializes the Geometria instance.

        Args:
            radio (int or float): Radio del círculo (en unidades de medida).

        Returns:
            (int or float).
        """
        self.radio = radio

    def calcular_area_circulo(self):
        # Fórmula del área de un círculo: π * r²
        return math.pi * (self.radio ** 2)

# Ejemplo usado
figura = Geometria(5)
print(figura.calcular_area_circulo())

